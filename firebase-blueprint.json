{
  "entities": {
    "EnvironmentUser": {
      "title": "EnvironmentUser",
      "description": "Server-managed user authentication record isolated per deployment environment.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "full_name": { "type": "string", "minLength": 2, "maxLength": 100 },
        "email": { "type": "string", "format": "email", "maxLength": 254 },
        "email_verified": { "type": "boolean" },
        "phone_e164": { "type": "string", "maxLength": 24 },
        "phone_verified": { "type": "boolean" },
        "created_at": { "type": "number" },
        "updated_at": { "type": "number" }
      },
      "required": ["id", "full_name", "email", "email_verified", "created_at", "updated_at"]
    },
    "AdminBinding": {
      "title": "AdminBinding",
      "description": "Immutable owner user binding record per environment.",
      "type": "object",
      "properties": {
        "owner_user_id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "bound_email": { "type": "string", "format": "email", "maxLength": 254 },
        "bound_at": { "type": "number" },
        "bound_via": { "type": "string", "maxLength": 64 }
      },
      "required": ["owner_user_id", "bound_email", "bound_at", "bound_via"]
    },
    "Product": {
      "title": "Product",
      "description": "Boutique catalog product document managed by the store owner.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "slug": { "type": "string", "maxLength": 120 },
        "title": { "type": "string", "minLength": 2, "maxLength": 140 },
        "category": { "type": "string", "maxLength": 64 },
        "sku": { "type": "string", "maxLength": 64 },
        "status": { "type": "string", "enum": ["draft", "published", "archived"] },
        "price_paise": { "type": "number" },
        "stock_qty": { "type": "number" },
        "version": { "type": "number" }
      },
      "required": ["id", "slug", "title", "category", "sku", "status", "price_paise", "stock_qty", "version"]
    },
    "Order": {
      "title": "Order",
      "description": "Server-validated customer boutique order (online Razorpay or Cash on Delivery).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "order_number": { "type": "string", "maxLength": 64 },
        "status": { "type": "string", "enum": ["pending", "placed", "confirmed", "packed", "shipped", "delivered", "cancelled", "return_requested", "returned"] },
        "payment_method": { "type": "string", "enum": ["razorpay", "cod"] },
        "payment_status": { "type": "string", "enum": ["unpaid", "pending", "paid", "failed", "refunded"] },
        "fulfillment_status": { "type": "string" },
        "idempotency_key": { "type": "string", "maxLength": 128 },
        "payment_collected_at": { "type": "number" },
        "total_paise": { "type": "number" },
        "created_at": { "type": "number" }
      },
      "required": ["id", "order_number", "status", "total_paise", "created_at"]
    },
    "Category": {
      "title": "Category",
      "description": "Boutique collection category metadata.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 80 },
        "slug": { "type": "string", "maxLength": 96 },
        "position": { "type": "number" }
      },
      "required": ["id", "name", "slug", "position"]
    },
    "SiteDocument": {
      "title": "SiteDocument",
      "description": "Storefront configuration or editorial content JSON document.",
      "type": "object",
      "properties": {
        "key": { "type": "string", "maxLength": 64 },
        "updated_at": { "type": "number" }
      },
      "required": ["key", "updated_at"]
    },
    "ContactMessage": {
      "title": "ContactMessage",
      "description": "Boutique customer enquiry submitted from the storefront contact form.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "sender_email": { "type": "string", "format": "email", "maxLength": 254 },
        "status": { "type": "string", "enum": ["unread", "read", "replied", "archived"] },
        "created_at": { "type": "number" }
      },
      "required": ["id", "sender_email", "status", "created_at"]
    },
    "CustomerAddress": {
      "title": "CustomerAddress",
      "description": "Saved customer delivery address.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "full_name": { "type": "string" },
        "phone": { "type": "string" },
        "line1": { "type": "string" },
        "city": { "type": "string" },
        "state": { "type": "string" },
        "pincode": { "type": "string" },
        "is_default": { "type": "boolean" }
      },
      "required": ["id", "full_name", "phone", "line1", "city", "state", "pincode"]
    },
    "CustomerNotification": {
      "title": "CustomerNotification",
      "description": "Order & account notification for signed-in customers.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "read": { "type": "boolean" },
        "created_at": { "type": "number" }
      },
      "required": ["id", "type", "title", "message", "read", "created_at"]
    },
    "Coupon": {
      "title": "Coupon",
      "description": "Storefront promotional coupon validated server-side.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "discount_type": { "type": "string", "enum": ["percent", "flat_paise"] },
        "discount_value": { "type": "number" },
        "active": { "type": "boolean" }
      },
      "required": ["id", "code", "discount_type", "discount_value", "active"]
    },
    "GiftCard": {
      "title": "GiftCard",
      "description": "Boutique gift card with server-verified balance.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "balance_paise": { "type": "number" },
        "active": { "type": "boolean" }
      },
      "required": ["id", "code", "balance_paise", "active"]
    }
  },
  "firestore": {
    "/environments/{envKey}/users/{userId}": {
      "schema": { "$ref": "#/entities/EnvironmentUser" },
      "description": "Environment-isolated server-managed user accounts."
    },
    "/environments/{envKey}/users/{userId}/addresses/{addressId}": {
      "schema": { "$ref": "#/entities/CustomerAddress" },
      "description": "Private customer saved delivery addresses."
    },
    "/environments/{envKey}/users/{userId}/notifications/{notifId}": {
      "schema": { "$ref": "#/entities/CustomerNotification" },
      "description": "Private customer order and account notifications."
    },
    "/environments/{envKey}/admin_bindings/{bindingId}": {
      "schema": { "$ref": "#/entities/AdminBinding" },
      "description": "Immutable verified store owner binding per environment."
    },
    "/environments/{envKey}/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Boutique products managed strictly through backend admin APIs."
    },
    "/environments/{envKey}/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Customer orders validated and persisted by backend APIs."
    },
    "/environments/{envKey}/coupons/{couponId}": {
      "schema": { "$ref": "#/entities/Coupon" },
      "description": "Storefront promo coupons."
    },
    "/environments/{envKey}/gift_cards/{cardId}": {
      "schema": { "$ref": "#/entities/GiftCard" },
      "description": "Storefront gift cards."
    },
    "/environments/{envKey}/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Storefront product categories managed by admin."
    },
    "/environments/{envKey}/site_documents/{docKey}": {
      "schema": { "$ref": "#/entities/SiteDocument" },
      "description": "Storefront site settings and editable page content."
    },
    "/environments/{envKey}/contact_messages/{messageId}": {
      "schema": { "$ref": "#/entities/ContactMessage" },
      "description": "Customer enquiries submitted through the contact form."
    }
  }
}
