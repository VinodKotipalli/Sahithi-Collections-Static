# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public base URL where this app is hosted (used in email verification & password reset links).
# Example: http://localhost:3000 in local dev or https://your-domain.com in production.
APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Sahithi Collections Backend Authentication & Persistent Storage (Server-Side Only)
# NEVER prefix these with VITE_ — keep all credentials strictly on the server.
# Environment target & Firestore namespace are auto-detected from K_SERVICE / APP_URL.
# ---------------------------------------------------------------------------

# Cloud Firestore authentication:
# By default, the server uses passwordless Application Default Credentials (ADC)
# via the Cloud Run / Google Cloud runtime service identity (grant roles/datastore.user
# on project celtic-pattern-fmln4). No downloaded JSON key is required on Google Cloud.
# Optional (only for external/non-GCP servers): raw or base64 service-account JSON.
# FIREBASE_SERVICE_ACCOUNT_JSON=""

# Local SQLite fallback path (used only when Firestore is unreachable/unpermitted,
# and as the source database for `npm run db:migrate-firestore`). Defaults to ./data/sahithi_auth.db
AUTH_DB_PATH="./data/sahithi_auth.db"

# ---------------------------------------------------------------------------
# SMTP Email Provider (Required for signup verification, password reset & email linking)
# Examples: Resend SMTP, Postmark, AWS SES, SendGrid, or Gmail App Password
# ---------------------------------------------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Sahithi Collections <no-reply@example.com>"

# ---------------------------------------------------------------------------
# Store Owner / Admin Account (Server-Side Only — Never Expose to Client)
# Option A (CLI): Run `npm run admin:setup` on the server to set/reset email & password.
# Option B (Hosting Secrets): Set ADMIN_OWNER_EMAIL + ADMIN_OWNER_PASSWORD in server secrets.
#   To reset the password via hosting secrets without email, temporarily also set
#   ADMIN_OWNER_PASSWORD_RESET="true", restart the server, then remove the reset flag.
# ---------------------------------------------------------------------------
ADMIN_OWNER_EMAIL="saivinodkotipalli2003@gmail.com"
# ADMIN_OWNER_PASSWORD=""
# ADMIN_OWNER_PASSWORD_RESET="false"

# ---------------------------------------------------------------------------
# Razorpay Standard Web Checkout (Server-Side / Vercel Environment Variables)
# Configure RAZORPAY_KEY_ID and RAZORPAY_KEY_SECRET in Vercel Project Settings.
# Never expose RAZORPAY_KEY_SECRET to the client bundle.
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Optional: Google/Firebase Service Account JSON for privileged server writes in Vercel Functions
# FIREBASE_SERVICE_ACCOUNT_JSON=""

# ---------------------------------------------------------------------------
# WhatsApp AI Styling Chatbot & Boutique Contact (Server-Side / Vercel)
# ---------------------------------------------------------------------------
WHATSAPP_PHONE_NUMBER="918520899337"
BOUTIQUE_EMAIL="saivinodkotipalli2003@gmail.com"
# Optional: Meta WhatsApp Business Cloud API credentials for automated 2-way WhatsApp replies
# WHATSAPP_VERIFY_TOKEN=""
# WHATSAPP_ACCESS_TOKEN=""
# WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_APP_SECRET=""


